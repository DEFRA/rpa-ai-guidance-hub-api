          "parsingStatus"
        ],
        "title": "StagedDocumentResponse",
        "type": "object"
      },
      "TestOperation": {
        "additionalProperties": false,
        "description": "Check that `path` still holds `value`, so a patch made on what has changed\nsince applies nothing.",
        "properties": {
          "op": {
            "const": "test",
            "title": "Op",
            "type": "string"
          },
          "path": {
            "title": "Path",
            "type": "string"
          },
          "value": {
            "$ref": "#/components/schemas/JsonValue"
          }
        },
        "required": [
          "path",
          "op",
          "value"
        ],
        "title": "TestOperation",
        "type": "object"
      },
      "UploadCallbackPayload": {
        "properties": {
