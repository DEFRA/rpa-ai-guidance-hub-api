              "type": "array"
            },
            "title": "Counts",
            "type": "object"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/PinnedSummary"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items",
          "counts"
        ],
        "title": "Pinned",
        "type": "object"
      },
      "PinnedGuide": {
        "description": "A guide the user has pinned, as the side navigation names it.",
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          }
        },
        "required": [
          "id",
          "title"
        ],
        "title": "PinnedGuide",
        "type": "object"
      },
      "PinnedSummary": {
        "description": "A pinned guide as `GET /guides` lists it, with its position among all the\nuser's pins, which a patch of the pins takes, whatever the filters show.",
        "properties": {
          "createdAt": {
            "format": "date-time",
            "title": "Createdat",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "latestVersion": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Version"
              },
              {
                "type": "null"
              }
            ]
          },
          "metadata": {
            "additionalProperties": true,
