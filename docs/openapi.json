            "type": "string"
          }
        },
        "required": [
          "guideId"
        ],
        "title": "OpenedGuide",
        "type": "object"
      },
      "OptionCount": {
        "description": "One value of a filter, labelled as the reference data labels it, and how many\nof the guides have it given the other filters chosen.",
        "properties": {
          "count": {
            "title": "Count",
            "type": "integer"
          },
          "label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Null for the guides with none of the filter's values",
            "title": "Label"
          },
          "retired": {
            "description": "Not in the reference data any more: counted, but not a choice",
            "title": "Retired",
            "type": "boolean"
          },
          "shortLabel": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Shortlabel"
          }
        },
        "required": [
          "label",
          "shortLabel",
          "count",
          "retired"
        ],
        "title": "OptionCount",
        "type": "object"
      },
      "ParsingStatus": {
        "enum": [
          "pending",
          "in_progress",
          "complete",
          "failed"
        ],
        "title": "ParsingStatus",
        "type": "string"
      },
      "Person": {
        "description": "Someone the auth provider knows.\n\nThe id is the machine identifier and is what anything should match on; the\ndisplay name is carried beside it so that a listing can say who made a version\nwithout asking a directory. That name is a copy taken at the time and will go\nstale if the person is renamed, which is the price of not needing the directory.",
        "properties": {
          "displayName": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Displayname"
          },
          "id": {
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "title": "Person",
        "type": "object"
      },
      "Pinned": {
        "description": "The guides the user has pinned, in their order, as `GET /guides` lists them,\nand each filter's values among them with their counts.",
        "properties": {
          "counts": {
            "additionalProperties": {
              "items": {
                "$ref": "#/components/schemas/OptionCount"
