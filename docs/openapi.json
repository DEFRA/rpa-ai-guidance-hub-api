            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "Version": {
        "description": "One conversion: where its Markdown went, and who made it.\n\nThe content URL is the whole of where. The pictures are named by the file itself,\nin addresses relative to that URL, so anything holding it can reach them and a\nsecond field pointing at them would be free to disagree with the file.\n\nThe title is a copy of what the stored document called itself when this version\nwas made, so that a list of versions reads as something a person can follow. The\nversion number is the author's, and null for a version stored before versions\nhad one.",
        "properties": {
          "contentUrl": {
            "title": "Contenturl",
            "type": "string"
          },
          "createdAt": {
            "format": "date-time",
            "title": "Createdat",
            "type": "string"
          },
          "createdBy": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Person"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "versionNumber": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Versionnumber"
          }
        },
        "required": [
          "id",
          "contentUrl",
          "createdAt"
        ],
        "title": "Version",
        "type": "object"
      }
