      "patch": {
        "description": "Change the guides the user has pinned by a JSON Patch (sent as\n`application/json-patch+json`) on their ordered ids:\n`add` (at `/0` to pin at the top), `remove`, `move` and `test`, on top-level\npositions only. The patch applies whole or not at all.\n\nPositions are as the user's pins are answered, without the guides that no\nlonger exist, which the patch leaves out of the pins it writes.\n\n409 when a `test` fails, as for a page showing pins that have changed since;\n422 for anything else, a guide pinned twice, or a guide there is not.",
        "operationId": "patch_pins_users__user_id__pins_patch",
        "parameters": [
          {
            "in": "path",
            "name": "user_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "User Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "items": {
                  "discriminator": {
                    "mapping": {
                      "add": "#/components/schemas/AddOperation",
                      "move": "#/components/schemas/MoveOperation",
                      "remove": "#/components/schemas/RemoveOperation",
                      "test": "#/components/schemas/TestOperation"
                    },
                    "propertyName": "op"
                  },
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/AddOperation"
                    },
                    {
                      "$ref": "#/components/schemas/RemoveOperation"
                    },
                    {
                      "$ref": "#/components/schemas/MoveOperation"
                    },
                    {
                      "$ref": "#/components/schemas/TestOperation"
                    }
                  ]
                },
                "title": "Operations",
                "type": "array"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Patch Pins",
        "tags": [
          "users"
        ]
      }
    },
