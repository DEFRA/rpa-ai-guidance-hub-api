      }
    }
  },
  "info": {
    "title": "RPA AI Guidance Hub API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/guides": {
      "get": {
        "description": "The documents there are, a page at a time, in order of when each last\nchanged, with each filter's values and how many guides have each.\n\nFilters take values from the reference data and can be repeated. `no_scheme`\nchooses the guides specific to no scheme, beside any `scheme`s chosen. Follow\n`nextCursor` for the next page; it is null on the last.",
        "operationId": "list_documents_guides_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "description": "The `nextCursor` of the page before this one",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The `nextCursor` of the page before this one",
              "title": "Cursor"
            }
          },
          {
            "in": "query",
            "name": "scheme",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Scheme"
            }
          },
          {
            "in": "query",
            "name": "system",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "title": "System"
            }
          },
          {
            "in": "query",
            "name": "audience",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Audience"
            }
          },
          {
            "in": "query",
            "name": "guidance_type",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Guidance Type"
            }
          },
          {
            "description": "The guides specific to no scheme too",
            "in": "query",
            "name": "no_scheme",
            "required": false,
            "schema": {
              "default": false,
              "description": "The guides specific to no scheme too",
              "title": "No Scheme",
              "type": "boolean"
            }
          },
          {
            "description": "By when each guide last changed",
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "default": "updated-newest",
              "description": "By when each guide last changed",
              "enum": [
                "updated-newest",
                "updated-oldest"
              ],
              "title": "Sort",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List Documents",
        "tags": [
          "guides"
        ]
      },
      "post": {
        "description": "Convert an upload and record the document it becomes.\n\nConverting the same upload twice answers the document it made the first time,\nrather than making a second one. The journey ahead of this can be submitted more\nthan once - a refresh, a back button, a retried request - and every one of those\nmeans the same version of the same document: a finished document is answered as\nit is, and an unfinished one is finished under the ids its first attempt\nreserved.",
        "operationId": "create_document_guides_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewDocument"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Document"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Create Document",
        "tags": [
          "guides"
        ]
      }
