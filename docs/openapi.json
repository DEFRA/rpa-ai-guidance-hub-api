            "title": "Uploadstatus",
            "type": "string"
          }
        },
        "required": [
          "uploadStatus"
        ],
        "title": "UploadCallbackPayload",
        "type": "object"
      },
      "User": {
        "description": "A user as answered: the hub's own id for them, who they are to the identity\nprovider, their name as of their latest sign-in, and when they first signed\nin. With them, the guides they have pinned, in their order, so a page asks\nonce.",
        "properties": {
          "createdAt": {
            "format": "date-time",
            "title": "Createdat",
            "type": "string"
          },
          "displayName": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Displayname"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "identity": {
            "$ref": "#/components/schemas/Identity"
          },
          "pinned": {
            "items": {
              "$ref": "#/components/schemas/PinnedGuide"
            },
            "title": "Pinned",
            "type": "array"
          }
        },
        "required": [
          "id",
          "identity",
          "displayName",
          "createdAt",
          "pinned"
        ],
        "title": "User",
