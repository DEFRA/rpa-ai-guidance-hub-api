{
  "components": {
    "schemas": {
      "AddOperation": {
        "additionalProperties": false,
        "description": "Put `value` at `path`: into a list at a position (`-` is the end), or as a\nmember of an object.",
        "properties": {
          "op": {
            "const": "add",
            "title": "Op",
            "type": "string"
          },
          "path": {
            "title": "Path",
            "type": "string"
          },
          "value": {
            "$ref": "#/components/schemas/JsonValue"
          }
        },
        "required": [
          "path",
          "op",
          "value"
        ],
        "title": "AddOperation",
        "type": "object"
      },
      "Document": {
        "description": "A document as it is answered: what it is, where it came from, when it was\nrecorded, and every version of it there has been.\n\n`createdAt` is when the document was recorded, which is when its first version\nwas: the moment it went live, since every upload does.",
        "properties": {
          "createdAt": {
            "format": "date-time",
            "title": "Createdat",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "metadata": {
            "additionalProperties": true,
            "title": "Metadata",
            "type": "object"
          },
          "source": {
            "$ref": "#/components/schemas/Source"
          },
          "versions": {
            "items": {
              "$ref": "#/components/schemas/Version"
            },
            "title": "Versions",
            "type": "array"
          }
        },
        "required": [
          "id",
          "metadata",
          "source",
          "createdAt",
          "versions"
        ],
        "title": "Document",
        "type": "object"
      },
      "DocumentPage": {
        "description": "One page of documents; `nextCursor` is null on the last. `counts` has, for\neach filter by its name (`scheme`, `system`, `audience`), the values the guides\nhave, each with how many, so a page can offer the filters from this one call.",
        "properties": {
          "counts": {
            "additionalProperties": {
              "items": {
                "$ref": "#/components/schemas/OptionCount"
              },
              "type": "array"
            },
            "title": "Counts",
            "type": "object"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/DocumentSummary"
            },
            "title": "Items",
            "type": "array"
          },
          "nextCursor": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nextcursor"
          }
        },
        "required": [
          "items",
          "nextCursor",
          "counts"
        ],
        "title": "DocumentPage",
        "type": "object"
      },
      "DocumentSummary": {
        "description": "A document as listed, with its newest version, and when the document was\nrecorded (as for `Document`).",
        "properties": {
          "createdAt": {
            "format": "date-time",
            "title": "Createdat",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
