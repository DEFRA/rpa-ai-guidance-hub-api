            "type": "object"
          },
          "position": {
            "title": "Position",
            "type": "integer"
          },
          "source": {
            "$ref": "#/components/schemas/Source"
          }
        },
        "required": [
          "id",
          "metadata",
          "source",
          "createdAt",
          "latestVersion",
          "position"
        ],
        "title": "PinnedSummary",
        "type": "object"
      },
      "ReferenceOption": {
        "description": "A reference option as returned on the wire.\n\n`label` is the option's identity: it is what documents store and filters\nmatch on. `short_label` is display-only (e.g. for chips and table columns) and\nis never stored or filtered by; it is omitted from the response when unset.",
        "properties": {
          "label": {
            "title": "Label",
            "type": "string"
          },
          "shortLabel": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Shortlabel"
          }
        },
        "required": [
          "label"
        ],
        "title": "ReferenceOption",
        "type": "object"
      },
      "RemoveOperation": {
        "additionalProperties": false,
        "description": "Take out what `path` names.",
        "properties": {
          "op": {
            "const": "remove",
            "title": "Op",
            "type": "string"
          },
          "path": {
            "title": "Path",
            "type": "string"
          }
        },
        "required": [
          "path",
          "op"
        ],
        "title": "RemoveOperation",
        "type": "object"
      },
      "SignedIn": {
        "description": "Someone who has just signed in, as the UI knows them from their token.",
        "properties": {
          "displayName": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Displayname"
          },
          "objectId": {
            "minLength": 1,
            "title": "Objectid",
            "type": "string"
          },
          "tenantId": {
            "minLength": 1,
            "title": "Tenantid",
            "type": "string"
          }
        },
        "required": [
          "tenantId",
          "objectId"
        ],
        "title": "SignedIn",
        "type": "object"
      },
      "Source": {
        "description": "Which upload the document is, as the front end knows it.\n\nOnly names it: where the file is, and whether it parsed, are read from its\nstaging record, so the caller never says where to read from.",
        "properties": {
          "fileId": {
            "description": "The file's id, as cdp-uploader's status reports it",
            "title": "Fileid",
            "type": "string"
          },
          "filename": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Filename"
          },
          "uploadId": {
            "title": "Uploadid",
            "type": "string"
          }
        },
        "required": [
          "uploadId",
          "fileId"
        ],
        "title": "Source",
        "type": "object"
      },
      "StagedDocumentResponse": {
        "properties": {
          "documentId": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
