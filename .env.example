AWS_REGION=eu-west-2
AWS_DEFAULT_REGION=eu-west-2
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_EMF_ENVIRONMENT=local
AWS_EMF_AGENT_ENDPOINT=tcp://127.0.0.1:25888
AWS_EMF_LOG_GROUP_NAME=log-group-name
AWS_EMF_LOG_STREAM_NAME=log-stream-name
AWS_EMF_NAMESPACE=namespace
AWS_EMF_SERVICE_NAME=service-name
AWS_EMF_SERVICE_TYPE=python-backend-service

AWS_BEARER_TOKEN_BEDROCK=dummy_token_for_bedrock
CLAUDE_SONNET_MODEL_CONFIG=anthropic.claude-sonnet-4-6,arn:aws:bedrock:eu-west-2:123456789012:application-inference-profile/fake-profile-test

FLOCI_ENDPOINT_URL=http://localhost:4566

# Required. CDP injects AWS_ACCOUNT in deployed environments; set it here for local runs.
# It also forms the caller role ARNs when auth is on.
AWS_ACCOUNT=123456789012
SOURCE_DOCS_S3_BUCKET=rpa-ai-guidance-hub-source-docs
MANAGED_DOCS_S3_BUCKET=rpa-ai-guidance-hub-managed-docs
CONVERSIONS_SQS_QUEUE_URL=http://localhost:4566/000000000000/rpa_ai_guidance_hub_conversions

# Authentication (off by default). When USE_AUTH=true, all routes except the /health
# ones and the docs need a CDP web-identity token; both CDP_JWT_* values are then required.
# CDP injects both in deployed environments; only set them here for local runs.
USE_AUTH=false
#CDP_JWT_ISSUER=https://issuer.example
#CDP_JWT_JWKS_URI=https://issuer.example/.well-known/jwks.json

REFERENCE_SCHEMES="Sustainable Farming Incentive|SFI,Countryside Stewardship|CS,Cross Compliance,Basic Payment Scheme|BPS"
REFERENCE_AUDIENCES="Processor,Team leader,Technical specialist,Manager,Other"
REFERENCE_SYSTEMS="CRM,SITI Agri,D365,Genesis,Land Management Services|LMS,RPA Application Portal,Rural Payments Service,Inspections Workbench,IMIS"
REFERENCE_GUIDANCE_TYPES="Process guide"

# Bookmarks to SBIs as well as case IDs (default false). Turn it on in the UI too.
FEATURE_SBI_BOOKMARKS=false

# Where each search is done (default hub-internal): hub-internal, a stand-in inside this
# API, for development only; or search-api, the search service at SEARCH_API_BASE_URL.
# Only FEATURE_SEARCH_ONE_GUIDE is read so far.
FEATURE_SEARCH_ONE_GUIDE=hub-internal
FEATURE_SEARCH_ALL_GUIDES=hub-internal
FEATURE_SEARCH_ALL_TITLES=hub-internal

# The search service's address (required: the API does not start without it).
SEARCH_API_BASE_URL=http://localhost:8086

# Client-side MongoDB timeouts, in seconds, per repository method (optional).
# FAST: single-document lookups and writes. STANDARD: filtered finds and counts.
# HEAVY: aggregations and bulk operations.
#MONGO_FAST_SECONDS=2
#MONGO_STANDARD_SECONDS=5
#MONGO_HEAVY_SECONDS=30
