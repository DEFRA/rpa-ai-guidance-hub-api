AWS_REGION=eu-west-2
AWS_DEFAULT_REGION=eu-west-2
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_EMF_ENVIRONMENT=local
AWS_EMF_AGENT_ENDPOINT=tcp://127.0.0.1:25888
AWS_EMF_LOG_GROUP_NAME=log-group-name
AWS_EMF_LOG_STREAM_NAME=log-stream-name
AWS_EMF_NAMESPACE=namespace
AWS_EMF_SERVICE_NAME=service-name
AWS_EMF_SERVICE_TYPE=python-backend-service

AWS_BEARER_TOKEN_BEDROCK=dummy_token_for_bedrock
CLAUDE_SONNET_MODEL_CONFIG=anthropic.claude-sonnet-4-6,arn:aws:bedrock:eu-west-2:123456789012:application-inference-profile/fake-profile-test

FLOCI_ENDPOINT_URL=http://localhost:4566

# Required. CDP injects AWS_ACCOUNT in deployed environments; set it here for local runs.
# It also forms the caller role ARNs when auth is on.
AWS_ACCOUNT=123456789012
SOURCE_DOCS_S3_BUCKET=rpa-ai-guidance-hub-source-docs
MANAGED_DOCS_S3_BUCKET=rpa-ai-guidance-hub-managed-docs

# Authentication (off by default). When USE_AUTH=true, all routes except /health and
# the docs need a CDP web-identity token; both CDP_JWT_* values are then required.
# CDP injects both in deployed environments; only set them here for local runs.
USE_AUTH=false
#CDP_JWT_ISSUER=https://issuer.example
#CDP_JWT_JWKS_URI=https://issuer.example/.well-known/jwks.json

REFERENCE_SCHEMES=Basic Payment Scheme|BPS,Countryside Stewardship
REFERENCE_AUDIENCES=Caseworker,Customer
REFERENCE_SYSTEMS=Siti Agri,CRM
REFERENCE_GUIDANCE_TYPES=Process guide
